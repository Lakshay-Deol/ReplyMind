# ---------------------------------------------------------------
# ReplyMind configuration
#
# Copy to .env and fill in. Nothing here is required for demo mode:
#   REPLYMIND_MODE=demo  ->  the full pipeline runs on seeded comments
#                            with no credentials and publishes nothing.
# ---------------------------------------------------------------

# Mode: demo | production
REPLYMIND_MODE=demo

# --- Minds Builder (required in production) ---
# Create a Mind at https://build.hellominds.ai/ and generate a Builder API key.
# The key is read only by the Node integration service, never by the browser.
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=
MINDS_SERVICE_PORT=3001
# Override if the integration service does not run on localhost:
# MINDS_SERVICE_URL=http://localhost:3001

# --- OpenAI (reply drafting) ---
OPENAI_API_KEY=

# --- YouTube OAuth (required in production) ---
# Run `python auth_youtube.py` once to mint secrets/refresh_token.txt
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=

# --- Publish guard ---
# Required in production. Approving a draft posts a real comment to your
# channel, so the console refuses to expose that action anonymously.
# Set any long random string, then sign in at /login.
REPLYMIND_CONSOLE_TOKEN=

# --- Paths ---
REFRESH_TOKEN_PATH=secrets/refresh_token.txt
ACCESS_TOKEN_PATH=runtime/access_token.json
RUNTIME_DIR=runtime

# --- Background monitor ---
REPLYMIND_MONITOR_ENABLED=false
REPLYMIND_INTERVAL_MINUTES=30
